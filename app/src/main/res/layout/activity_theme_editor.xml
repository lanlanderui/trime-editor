<?xml version="1.0" encoding="utf-8"?>
<!--
  样式编辑页：上面一块真实的预览板，下面是 style 字段表单。
  两者必须同屏——改一个数值要看得到键盘跟着变，否则「写盘成功」只是文件里的字符串变了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- 宽度必须与输入法一致：预览板按传入宽度算键宽，任何内边距都会让它变成另一个键盘 -->
    <FrameLayout
        android:id="@+id/boardHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!--
      主题文件被输入法改过时出现。放在预览板和表单之间，是因为它同时否定了这两块：
      上面的键盘是旧文件画的，下面的行也是旧文件的。整条可点，不做小按钮。
    -->
    <LinearLayout
        android:id="@+id/staleBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/stale_fill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/staleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editor_stale_title"
            android:textColor="@color/stale_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/staleAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp"
            android:text="@string/editor_stale_action"
            android:textColor="@color/stale_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
