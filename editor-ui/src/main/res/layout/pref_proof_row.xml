<!--
  四列行：中文名 / 键名＋引用锚点 / 色块 / 十六进制。

  四样缺一样，改主题的人就得去开文件：中文名用来认、键名用来抄、色块用来
  看、hex 用来对。分隔线缩进一个 gutter（不是整行通栏），是为了让「一行」
  看起来是纸上的一个条目，而不是列表里的一格。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/ui_row_pad_v"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/ui_row_pad_v">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/proofName"
                style="@style/Ui.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/proofKey"
                    style="@style/Ui.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/proofAnchor"
                    style="@style/Ui.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="?attr/ui_mark"
                    android:visibility="gone" />

                <!--
                  锚点要贴着键名（`back_color *color2` 是一句话），中间不能有
                  可伸缩的空隙；把剩余宽度交给这根弹簧，长键名才会自己截断。
                -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/proofSwatch"
            android:layout_width="@dimen/ui_swatch"
            android:layout_height="@dimen/ui_swatch"
            android:layout_marginStart="@dimen/ui_row_gap" />

        <TextView
            android:id="@+id/proofHex"
            style="@style/Ui.Value"
            android:layout_width="@dimen/ui_hex_w"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:singleLine="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:background="?attr/ui_rule" />
</LinearLayout>
